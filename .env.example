# Copy to .env and fill in real values. .env is gitignored -- never commit it.

OPENROUTER_API_KEY=

# Optional. Per-Mtok pricing for cost_log entries logged for the
# classifier/moderation calls above -- defaults match
# docs/unit-economics.md's assumed figures for the *_API_MODEL_ID
# defaults. Override these too if you override *_API_MODEL_ID, or logged
# cost keeps pricing the old model.
# CLASSIFIER_COST_INPUT_PER_MTOK=0.3
# CLASSIFIER_COST_OUTPUT_PER_MTOK=2.5
# MODERATION_COST_INPUT_PER_MTOK=0.03
# MODERATION_COST_OUTPUT_PER_MTOK=0.17

POSTGRES_USER=neochat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=neochat
# 127.0.0.1 defaults below are for running cmd/server on the host (see
# docs/running-locally.md's "Running without Docker"). docker-compose.yml's
# "server" service overrides both to the in-network service names
# (postgres/redis) itself -- no need to edit these for `docker compose up`.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme

IDEMPOTENCY_TTL=24h
