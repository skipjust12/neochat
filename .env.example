# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Model calls go through Polza AI (https://polza.ai, keys look like pza_...).
# Each user pastes their own Polza key in Settings -> Account; it is sent per
# request and never stored server-side. POLZA_API_KEY is only an optional
# fallback for calls that arrive without a user key -- leave it empty to
# require every user to bring their own.
POLZA_API_KEY=

# Catalog model (configs/models.json id) that runs each web search through
# Polza's web plugin. It only copies search results, so the cheapest
# current model is the default.
# WEB_SEARCH_MODEL=gpt-6-luna

# The auto-router (classifier + moderation + routing) is off by default:
# only Manual mode works and goes straight to the chosen model. Set to true
# to bring the full routed pipeline back.
# ROUTER_ENABLED=false

# Optional. Per-Mtok pricing for cost_log entries logged for the
# classifier/moderation calls above -- defaults match
# docs/unit-economics.md's assumed figures for the *_API_MODEL_ID
# defaults. Override these too if you override *_API_MODEL_ID, or logged
# cost keeps pricing the old model.
# CLASSIFIER_COST_INPUT_PER_MTOK=0.3
# CLASSIFIER_COST_OUTPUT_PER_MTOK=2.5
# MODERATION_COST_INPUT_PER_MTOK=0.03
# MODERATION_COST_OUTPUT_PER_MTOK=0.17

POSTGRES_USER=neochat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=neochat
# 127.0.0.1 defaults below are for running cmd/server on the host (see
# docs/running-locally.md's "Running without Docker"). docker-compose.yml's
# "server" service overrides both to the in-network service names
# (postgres/redis) itself -- no need to edit these for `docker compose up`.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# disable is correct only because the docker-compose Postgres serves no
# TLS. Set require (or verify-full) for any database not on this machine
# -- with disable, credentials and every stored conversation cross the
# network in cleartext.
POSTGRES_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme

IDEMPOTENCY_TTL=24h

# Optional. Hard ceiling on output tokens for every generation call --
# see provider.PolzaClient.MaxTokens. Defaults to 16000; valid range is 1..16000.
# MAX_OUTPUT_TOKENS=16000

# Optional. Max requests per minute per client IP on POST /chat and
# /chat/stream -- see server.Server.IPRateLimiter. Defaults to 60.
# Keep headroom here for however many users may share one NAT.
# RATE_LIMIT_PER_MINUTE=60

# Optional. Max requests per minute per authenticated user_id (i.e. per
# API key) on the same two endpoints -- see server.Server.UserRateLimiter.
# Defaults to 60. Counts one key across every IP it's used from, which is
# what the per-IP limit above structurally cannot see. This is the one to
# tighten first once there's real usage data: a human sends single-digit
# messages per minute.
# USER_RATE_LIMIT_PER_MINUTE=60

# Production: use compose.production.yml, a DNS hostname, and the migration
# procedure in SECURITY.md. Do not expose the development HTTP port publicly.
NEOCHAT_DOMAIN=chat.example.com
SUMMARIZER_COST_INPUT_PER_MTOK=0.3
SUMMARIZER_COST_OUTPUT_PER_MTOK=2.5
